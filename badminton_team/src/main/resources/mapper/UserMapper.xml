<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.badminton_team.dao.UserDao">

    <resultMap id="BaseResultMap" type="com.example.badminton_team.entity.User">
        <id column="uid" property="uid" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="nickname" property="nickname" />
        <result column="email" property="email" />
        <result column="phone" property="phone" />
        <result column="avatar" property="avatar" />
        <result column="skill_level" property="skillLevel" />
        <result column="gender" property="gender" />
        <result column="birthday" property="birthday" />
        <result column="signature" property="signature" />
        <result column="status" property="status" />
        <result column="province" property="province" />
        <result column="city" property="city" />
        <result column="district" property="district" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        uid, username, password, nickname, email, phone, avatar, skill_level, gender,
        birthday, signature, province, city, district, status, create_time, update_time
    </sql>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        WHERE username = #{username}
    </select>

    <select id="findByUid" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        WHERE uid = #{uid}
    </select>

    <insert id="insert" parameterType="com.example.badminton_team.entity.User" useGeneratedKeys="true" keyProperty="uid">
        INSERT INTO user (username, password, nickname, email, phone, avatar, skill_level,
                          gender, birthday, signature, province, city, district, status, create_time, update_time)
        VALUES (#{username}, #{password}, #{nickname}, #{email}, #{phone}, #{avatar},
                #{skillLevel}, #{gender}, #{birthday}, #{signature}, #{province}, #{city},
                #{district}, #{status}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.example.badminton_team.entity.User">
        UPDATE user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="skillLevel != null">skill_level = #{skillLevel},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="signature != null">signature = #{signature},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="district != null">district = #{district},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE uid = #{uid}
    </update>

    <update id="updateStatus">
        UPDATE user SET status = #{status}, update_time = NOW() WHERE uid = #{uid}
    </update>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
    </select>

    <select id="search" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        <where>
            <if test="keyword != null and keyword != ''">
                (nickname LIKE CONCAT('%', #{keyword}, '%') OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <select id="findByEmail" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        WHERE email = #{email}
    </select>

    <select id="findPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        <where>
            <if test="keyword != null and keyword != ''">
                (username LIKE CONCAT('%', #{keyword}, '%')
                OR nickname LIKE CONCAT('%', #{keyword}, '%')
                OR email LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY uid DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM user
        <where>
            <if test="keyword != null and keyword != ''">
                (username LIKE CONCAT('%', #{keyword}, '%')
                OR nickname LIKE CONCAT('%', #{keyword}, '%')
                OR email LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM user
    </select>

    <select id="findAllExcept" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        WHERE uid != #{excludeUid}
        AND status = 0
    </select>
</mapper>