<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.badminton_team.dao.ActivityParticipantDao">

    <resultMap id="BaseResultMap" type="com.example.badminton_team.entity.ActivityParticipant">
        <id column="id" property="id" />
        <result column="activity_id" property="activityId" />
        <result column="user_id" property="userId" />
        <result column="status" property="status" />
        <result column="join_time" property="joinTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, activity_id, user_id, status, join_time
    </sql>

    <select id="findByActivityId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM activity_participant
        WHERE activity_id = #{activityId}
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM activity_participant
        WHERE user_id = #{userId}
    </select>

    <select id="findByActivityAndUser" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM activity_participant
        WHERE activity_id = #{activityId} AND user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.example.badminton_team.entity.ActivityParticipant" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_participant (activity_id, user_id, status, join_time)
        VALUES (#{activityId}, #{userId}, #{status}, NOW())
    </insert>

    <update id="updateStatus">
        UPDATE activity_participant SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM activity_participant WHERE id = #{id}
    </delete>

</mapper>