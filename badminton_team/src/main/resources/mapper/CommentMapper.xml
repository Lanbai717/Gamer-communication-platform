<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.badminton_team.dao.CommentDao">

    <resultMap id="BaseResultMap" type="com.example.badminton_team.entity.Comment">
        <id column="cid" property="cid" />
        <result column="post_id" property="postId" />
        <result column="user_id" property="userId" />
        <result column="userName" property="userName" />
        <result column="content" property="content" />
        <result column="parent_id" property="parentId" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        c.cid, c.post_id, c.user_id, u.nickname AS userName, c.content, c.parent_id, c.create_time
    </sql>

    <select id="findByCid" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.uid
        WHERE c.cid = #{cid}
    </select>

    <select id="findByPostId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.uid
        WHERE c.post_id = #{postId}
        ORDER BY c.create_time ASC
    </select>

    <select id="findReplies" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.uid
        WHERE c.parent_id = #{parentId}
        ORDER BY c.create_time ASC
    </select>

    <insert id="insert" parameterType="com.example.badminton_team.entity.Comment" useGeneratedKeys="true" keyProperty="cid">
        INSERT INTO comment (post_id, user_id, content, parent_id, create_time)
        VALUES (#{postId}, #{userId}, #{content}, #{parentId}, NOW())
    </insert>

    <delete id="delete">
        DELETE FROM comment WHERE cid = #{cid}
    </delete>

</mapper>